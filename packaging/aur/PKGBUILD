# Maintainer: mrxehmad <github@users.noreply.github.com>  # TODO: set your real email/name
pkgname=wol-gui
pkgver=0.1.0
pkgrel=1
pkgdesc='Simple GTK3 Wake-on-LAN GUI for Linux'
arch=('x86_64')
url='https://github.com/mrxehmad/wol-gui'
license=('MIT')
depends=('gtk3')
makedepends=('gcc' 'make' 'pkgconf')
source=("https://github.com/mrxehmad/wol-gui/archive/refs/tags/v${pkgver}.tar.gz")
# IMPORTANT: update this hash after publishing the tag, e.g. run
#   updpkgsums          (in the AUR clone directory), or
#   makepkg --verifysource -fam
# until then keep it as SKIP for local testing only.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/wol-gui-${pkgver}"
  make
}

package() {
  cd "${srcdir}/wol-gui-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
